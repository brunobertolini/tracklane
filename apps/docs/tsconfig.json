{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "noEmit": true,
    // Third-party React/Fumadocs props are not written against this flag.
    // It stays ON for the published library, where the public API is ours.
    "exactOptionalPropertyTypes": false,
    "declaration": false,
    "sourceMap": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
