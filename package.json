{
  "name": "tracklane-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the tracklane library and its documentation site",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "package:check": "turbo run package:check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm package:check",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "2.31.1",
    "knip": "6.29.0",
    "turbo": "2.10.7",
    "typescript": "catalog:"
  }
}
