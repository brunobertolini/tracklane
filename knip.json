{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "packages/tln": {
      "entry": ["src/**/*.test-d.ts"]
    },
    "apps/docs": {
      "entry": ["src/app/**/{page,layout,route,not-found}.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
